[Unit]
Description=VeppStatus Data Collection Server
After=network.target
Before=veppstatus-django.service

[Service]
Type=simple
User=veppstatus
Group=veppstatus
WorkingDirectory=/opt/veppstatus/current-interface
Environment=PATH=/opt/veppstatus/venv/bin
Environment=LD_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu/
ExecStart=/opt/veppstatus/venv/bin/python current_state_server.py
Restart=always
RestartSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=veppstatus-data

# Безопасность
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/veppstatus/current-interface
ProtectHome=true

# Ограничения ресурсов
MemoryLimit=256M
MemoryAccounting=true
CPUAccounting=true
TasksAccounting=true
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target